# Downloaded third-party benchmark data (see benchmarks/public_locomo.py)
benchmarks/data/

# Local memory store used to prime the session (Cos protocol)
.state/

# Python
__pycache__/
*.py[cod]
.venv/

# Local secrets (managed through the Keys / API keys UI, never committed)
.env
.env.local

# Scoped benchmark artefacts: only the full default run writes the committed report
benchmarks/RESULTS-*.md
benchmarks/results/raw-*.json
